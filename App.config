<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <connectionStrings>
        <add name="MySqlConn" 
             connectionString="Server=localhost;Port=3306;Database=online_exams_db;Uid=root;Pwd=;AllowUserVariables=True;CharSet=utf8mb4;" 
             providerName="MySqlConnector" />
    </connectionStrings>
    <appSettings>
        <add key="SystemName" value="Online Professional Exams Scheduling and Management System" />
        <add key="DeveloperName" value="Manzi Herve" />
        <add key="StudentId" value="24605" />
        <add key="Course" value="DotNet" />
        <add key="Group" value="A" />
        <add key="RescheduleCutoffHours" value="24" />
        <add key="CurrencySymbol" value="$" />
        
        <!-- =====================================================================
             SMTP Email Configuration for Real Inbox Dispatch (FR-1.2 / FR-1.4)
             =====================================================================
             Fill in SmtpUsername and SmtpPassword with your Gmail credentials.
             For Gmail: use an App Password (not your regular password).
             Generate one at: https://myaccount.google.com/apppasswords
             (requires 2-Step Verification to be enabled on your Google account)
             SmtpFrom must match the Gmail address in SmtpUsername.
             ===================================================================== -->
        <add key="SmtpHost" value="smtp.gmail.com" />
        <add key="SmtpPort" value="587" />
        <add key="SmtpUsername" value="menzhervin@gmail.com" />
        <add key="SmtpPassword" value="vunpxbeqfythrwcl" />
        <add key="SmtpFrom" value="menzhervin@gmail.com" />
        <add key="SmtpEnableSsl" value="true" />
    </appSettings>
</configuration>
